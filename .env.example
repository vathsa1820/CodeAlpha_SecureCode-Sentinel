# SecureCode Sentinel Environment Configuration Example
# Copy to .env for local development overrides

# Server Configuration
HOST=127.0.0.1
PORT=8000

# Analyzer Execution Mode ("local" | "docker")
ANALYZER_MODE=local

# Docker Container Isolation Configuration (Used when ANALYZER_MODE=docker)
DOCKER_ANALYZER_IMAGE=securecode-sentinel-analyzer:latest
DOCKER_MEMORY_LIMIT=512m
DOCKER_CPU_LIMIT=1.0
DOCKER_PIDS_LIMIT=64
DOCKER_TIMEOUT_SECONDS=30
DOCKER_TMPFS_SIZE=64m
DOCKER_USER=10001:10001

# CORS & Frontend Origins
FRONTEND_ORIGIN=http://localhost:5173

# Security Limits
MAX_SOURCE_SIZE_BYTES=512000
ANALYZER_TIMEOUT_SECONDS=30
